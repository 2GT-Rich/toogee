# Copy to .env and fill in. .env stays on this Mac; don't share it.

# Open WebUI on this Mac
OPENWEBUI_URL=http://localhost:3000
# Open WebUI -> Settings -> Account -> API Keys -> Create new secret key
OPENWEBUI_API_KEY=
# Run `.venv/bin/python wili_assistant.py --check` to list model ids
OPENWEBUI_MODEL=

# Optional
# WILI_NAME=TooGee             # the assistant's name, and its wake word
# WILI_WAKE=name               # name (say the name to wake it) or off (buttons only)
# WILI_WAKE_MODEL=base.en      # local Whisper model for hearing the name
# WILI_TTS=kokoro              # kokoro (local, via tts/) or say (macOS)
# WILI_KOKORO_VOICE=af_sky     # af_sky, af_heart, af_bella, af_nicole, am_michael, bf_emma, ...
# WILI_KOKORO_SPEED=1.1
# WILI_WEB_SEARCH=on           # on: the model may search the web via Open WebUI; off: never
# WILI_VOCAB=Name1,Name2       # names you say that speech recognition misspells (spelling hints)
# WILI_LOCATION=Portland, Maine  # home city for weather (unset: TooGee asks which city)
# WILI_UNITS=imperial          # imperial (°F, mph) or metric
# WILI_SPEAKER=board           # board (the Wili board's speaker) or mac
# WILI_VOLUME=9                # starting board speaker volume, 0-10 (a volume set by voice is remembered and wins)
# WILI_LED_BRIGHTNESS=25       # LED bar brightness, percent
# WILI_MAX_LISTEN_SEC=12       # longest you can talk per turn
# WILI_SILENCE_SEC=1.2         # pause length that ends your turn
# WILI_HISTORY_TURNS=6         # how many back-and-forths it remembers
# WILI_SYSTEM_PROMPT=...
