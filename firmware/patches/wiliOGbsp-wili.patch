+/* ---- Stream mode (added for apps/wili) ----
+ * Instead of a fixed buffer, each ping-pong refill asks `fill` for up to
+ * `capacity` samples (16-bit mono) and returns how many it wrote; the driver
+ * applies the volume and zero-fills the rest. The chain never drains on its
+ * own -- an empty source plays silence -- so the app ends playback with
+ * i2s_audio_stop(), which parks the SM (the only true mute, trap 2).
+ * `fill` runs from i2s_audio_process(), i.e. on the caller's core, never in
+ * an interrupt. Returns false if not initialised or already playing. */
+typedef unsigned (*i2s_audio_stream_fn)(int16_t *out, unsigned capacity);
+bool i2s_audio_start_stream(i2s_audio_stream_fn fill);
