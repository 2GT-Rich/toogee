+bool i2s_audio_start_stream(i2s_audio_stream_fn fill) {
+    if (!s_ready || s_playing || !fill) return false;
+    s_stream_fill = fill;
+    s_src = NULL;
+    s_total_samples = 0;
+    s_current_sample = 0;
+    refill(I2S_AUDIO_BUFFER_A);
+    refill(I2S_AUDIO_BUFFER_B);
+    unpark_internal();
+    configure_dma_chain();
+    s_active = I2S_AUDIO_BUFFER_A;
+    s_playing = true;
+    return true;
+}
