diff --git a/bsp/display_cpu/lcd/st7789.c b/bsp/display_cpu/lcd/st7789.c
index 6d58a8d..73343a1 100644
--- a/bsp/display_cpu/lcd/st7789.c
+++ b/bsp/display_cpu/lcd/st7789.c
@@ -399,6 +399,43 @@ void st7789_fill_rect(uint16_t x, uint16_t y, uint16_t w, uint16_t h,
                           st7789_dma_xfer_count(w, h), true);
 }
 
+/* Added for apps/wili: DMA a w*h buffer of RGB565 pixels (native-endian
+   halfwords, exactly what the CPU writes) into a window, without blocking.
+   Same 16-bit-frame trick as st7789_fill_rect(), but with read increment.
+   The caller must not touch `px` until st7789_busy() is false or
+   st7789_dma_wait() returns -- the next st7789_* call waits for it anyway. */
+void st7789_blit_rect_async(uint16_t x, uint16_t y, uint16_t w, uint16_t h,
+                            const uint16_t *px) {
+    if (!st7789_ready() || !px) return;
+    st7789_dma_wait();
+    uint16_t cw = w, ch = h;
+    if (!st7789_clip_rect(x, y, &cw, &ch)) return;
+    if (cw != w) {          /* rows would be misaligned; only clip height */
+        st7789_set_window(x, y, w, h);
+        st7789_blit(px, (size_t)w * h);
+        return;
+    }
+    st7789_set_window(x, y, w, ch);
+    if (s_dma_ch < 0) {
+        /* No DMA: blocking path with the driver's own byte swap. */
+        st7789_blit(px, (size_t)w * ch);
+        return;
+    }
+    ramwr_begin();
+    spi_set_format(FWOG_LCD_SPI, 16, SPI_CPOL_0, SPI_CPHA_0, SPI_MSB_FIRST);
+    dma_channel_config c = dma_channel_get_default_config((uint)s_dma_ch);
+    channel_config_set_transfer_data_size(&c, DMA_SIZE_16);
+    channel_config_set_read_increment(&c, true);
+    channel_config_set_write_increment(&c, false);
+    channel_config_set_dreq(&c, spi_get_dreq(FWOG_LCD_SPI, true));
+    channel_config_set_irq_quiet(&c, true);
+    s_fill_active = true;
+    dma_channel_configure((uint)s_dma_ch, &c,
+                          &spi_get_hw(FWOG_LCD_SPI)->dr,
+                          px,
+                          st7789_dma_xfer_count(w, ch), true);
+}
+
 void st7789_clear(uint16_t color) {
     st7789_fill_rect(0u, 0u, ST7789_W, ST7789_H, color);
 }
